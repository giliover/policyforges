{
  "name": "policyforges-monorepo",
  "version": "1.0.2",
  "private": true,
  "description": "PolicyForges monorepo",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "build:cli": "npm run build --workspace=@policyforges/cli",
    "build:runtime": "npm run build --workspace=@policyforges/react",
    "build": "npm run build:runtime && npm run build:cli",
    "pack:cli": "npm pack --workspace=@policyforges/cli",
    "pack:react": "npm pack --workspace=@policyforges/react",
    "publish:cli": "npm publish --workspace=@policyforges/cli --access public",
    "publish:react": "npm publish --workspace=@policyforges/react --access public",
    "publish:all": "npm run publish:check && npm run publish:react && npm run publish:cli",
    "pack:check": "npm run build && npm pack --workspace=@policyforges/react --dry-run && npm pack --workspace=@policyforges/cli --dry-run",
    "publish:check": "npm run pack:check",
    "check:cli": "node packages/cli/dist/index.js --help",
    "version:check": "node scripts/check-versions.cjs"
  },
  "devDependencies": {
    "typescript": "^5.0.0"
  }
}
