{
  "name": "@policyforges/cli",
  "version": "1.0.4",
  "main": "./dist/index.js",
  "bin": {
    "policyforges": "./dist/index.js"
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "commander": "^11.0.0",
    "esbuild": "^0.28.2"
  },
  "devDependencies": {
    "@types/node": "^20.0.0"
  },
  "description": "CLI para compilar políticas RBAC e gerar um servidor de distribuição autorizada de módulos JavaScript",
  "license": "MIT",
  "type": "commonjs",
  "files": [
    "dist/",
    "templates/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "types": "./dist/index.d.ts",
  "keywords": [
    "policyforges",
    "rbac",
    "security",
    "typescript",
    "cli",
    "dsl"
  ]
}
